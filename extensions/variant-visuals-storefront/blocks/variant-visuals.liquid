{% if request.page_type == 'product' and product %}
  {% assign variant_visuals_config = product.metafields.cariana_visuals.variant_image_map.value %}
  {% if variant_visuals_config != blank %}
    <script type="application/json" data-cariana-variant-visuals-config>
      {{ variant_visuals_config | json }}
    </script>
    <script type="application/json" data-cariana-variant-visuals-media>
      [
        {% for media in product.media %}
          {
            "id": "{{ media.id }}",
            "gid": "gid://shopify/MediaImage/{{ media.id }}",
            "alt": {{ media.alt | json }},
            "src": {{ media.preview_image | image_url: width: 2048 | json }},
            "key": {{ media.preview_image.src | split: '/' | last | split: '?' | first | json }}
          }{% unless forloop.last %},{% endunless %}
        {% endfor %}
      ]
    </script>
    <script type="application/json" data-cariana-variant-visuals-variants>
      [
        {% for variant in product.variants %}
          {
            "id": "{{ variant.id }}",
            "gid": "gid://shopify/ProductVariant/{{ variant.id }}",
            "available": {{ variant.available | json }},
            "selectedOptions": [
              {% for option in variant.selected_options %}
                {
                  "name": {{ option.name | json }},
                  "value": {{ option.value | json }}
                }{% unless forloop.last %},{% endunless %}
              {% endfor %}
            ]
          }{% unless forloop.last %},{% endunless %}
        {% endfor %}
      ]
    </script>
  {% endif %}
{% endif %}

{% schema %}
{
  "name": "Visual variants",
  "target": "body",
  "javascript": "variant-visuals.js",
  "stylesheet": "variant-visuals-preload.css",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": []
}
{% endschema %}
